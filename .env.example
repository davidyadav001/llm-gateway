# Copy to .env in the project root before running `docker-compose up`.
# docker-compose reads this automatically.

DB_USERNAME=gateway
DB_PASSWORD=change_me
DB_DATABASE=llm_gateway
REDIS_URL=redis://localhost:6379

# Generate unique random values with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_unique_random_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_a_different_unique_random_secret_at_least_32_chars
JWT_REFRESH_TTL=7d
AUDIT_HASH_SECRET=replace_with_a_unique_audit_hash_secret_at_least_32_chars
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# mock | anthropic | openai
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

POLICY_BLOCKED_CATEGORIES=weapons,malware,csam,extremism

VITE_API_BASE_URL=http://localhost:3000
