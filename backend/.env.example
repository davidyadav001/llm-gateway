# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
# Use localhost when running the backend or seed command from the host.
# Docker Compose overrides this with DB_HOST=postgres inside the container.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gateway
DB_PASSWORD=change_me
DB_DATABASE=llm_gateway

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_refresh_secret
JWT_REFRESH_TTL=7d

# --- Rate limiting (per user) ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# --- LLM Provider ---
# Supported: "anthropic" | "openai" | "mock"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Policy ---
# Comma-separated list of category keywords the PolicyService will block.
# This is a naive keyword-based prototype filter, not a real content-safety system.
POLICY_BLOCKED_CATEGORIES=weapons,malware,csam,extremism
